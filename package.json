{
  "name": "django-assignment",
  "version": "1.0.0",
  "private": true,
  "description": "CSS build tooling for the Django material catalog",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/input.css -o ./static/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
